# runner/.env にコピーして値を入れる（.env は git に入らない）

# Firebase（管理サイトと同じプロジェクト。Firebase コンソール › プロジェクトの設定 › マイアプリ）
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=<project-id>.firebaseapp.com
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=

# ランナー用のユーザー（Firebase Authentication で作り、Firestore の members/<uid> に role: "runner" を入れる）
RUNNER_EMAIL=
RUNNER_PASSWORD=

# Gmail API（Google Cloud の OAuth クライアント「デスクトップ アプリ」）。トークンは node runner/gmail-auth.ts で取る
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# dry-run：送らずに「送る予定」だけ記録する（最初はこのまま試運転する） / live：実際に送る
SEND_MODE=dry-run

# 任意
# RUNNER_ID=office-mac
# POLL_SEC=30
# JOB_TIMEOUT_MIN=40
# MAX_BUDGET_USD=3
# SEND_INTERVAL_SEC=5
# CLAUDE_BIN=/Users/<you>/.local/bin/claude
